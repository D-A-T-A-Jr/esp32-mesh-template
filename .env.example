TB_HOST=
TB_PORT=1883

FW_TITLE=esp32-mesh-node
FW_VERSION=1.0.0

# WiFi nao vem daqui: a placa sobe um AP de configuracao (WiFiManager) no
# primeiro boot ou sempre que nao conseguir conectar. Configura a rede
# direto pelo celular/notebook, ai fica salvo na flash da placa.

# So pra placa standalone (MESH_ENABLED=0 no mesh_node_core.cpp) -- placa de
# malha nao usa, cada uma tem seu proprio token via NODE_<id>_TOKEN abaixo.
# TB_TOKEN=

# Um NODE_<id>_TOKEN/NODE_<id>_NAME por placa da malha (todas, nao so essa). <id> vem
# do boot Serial: "[MESH] Node ID: ...". Ver AGENTS.md.
# NODE_3520320713_TOKEN=
# NODE_3520320713_NAME=esp32-placa1
